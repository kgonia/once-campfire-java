-      n=$((n + 1)); fetch "$cookie" "$room" | cmp -s - "$OUT/expected/$n.html" || die "$app's room $room for person $person differs from the Rust port's"
+      n=$((n + 1)); fetch "$cookie" "$room" > "$smoke/page.html"
+      same_page "$app" "$OUT/expected/$n.html" "$smoke/page.html" || die "$app's room $room for person $person differs from the Rust port's"
