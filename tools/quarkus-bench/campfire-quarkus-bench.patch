+# Whether every PAGE equals EXPECTED: byte for byte, or for the Java port as markup (its
+# tools/parity/markup.py: tags with sorted, decoded attributes and collapsed whitespace), since it
+# renders the same elements as Rust with other spelling.
+same_page() {  # APP EXPECTED PAGE...
+  local app=$1 expected=$2 f; shift 2
+  if [ "$app" = java ]; then
+    python3 -B - "$JAVA_PORT/tools/parity" "$expected" "$@" <<'EOF'
+import sys
+sys.path.insert(0, sys.argv[1])
+from markup import tokens
+want = tokens(open(sys.argv[2], encoding='utf-8').read())
+sys.exit(any(tokens(open(f, encoding='utf-8').read()) != want for f in sys.argv[3:]))
+EOF
+  else
+    for f in "$@"; do cmp -s "$f" "$expected" || return 1; done
+  fi
+}
